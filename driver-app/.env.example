# Copy this file to .env and fill in the same two values as rider-web/.env
# (Supabase: Project Settings -> API Keys, and the Connect button for the URL).
# The EXPO_PUBLIC_ prefix tells Expo it's safe to build these into the app.
# Use the publishable key (sb_publishable_...). NEVER the secret / service_role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
