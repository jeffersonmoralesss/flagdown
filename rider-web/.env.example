# Copy this file to .env and fill in your Supabase project values (Project Settings -> API Keys).
# Leave them empty to run in demo mode with eight made-up cabs that drive around you.
# Use the publishable key (sb_publishable_...) or the legacy anon key. NEVER the secret / service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: a different map style. Defaults to free OpenFreeMap tiles (no key needed).
VITE_MAP_STYLE_URL=
